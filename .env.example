# Credenciales del formulario de contacto.
#
# Las consume api/contact.js, que se ejecuta en el servidor. NO llevan el
# prefijo REACT_APP_ a propósito: ese prefijo hace que Create React App las
# incruste en el bundle del cliente, y entonces dejarían de ser secretas.
#
# GMAIL_APP_PASSWORD no es la contraseña de la cuenta: es una "contraseña de
# aplicación" de 16 caracteres que se genera en
# https://myaccount.google.com/apppasswords (requiere verificación en dos pasos).

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Opcional: dirección de destino. Si se omite, los mensajes llegan a GMAIL_USER.
CONTACT_TO=
